{
  "name": "growth-arc",
  "version": "0.8.7",
  "private": true,
  "description": "炉火营地：本地优先的像素陪伴与远征记录",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "prebuild": "npm run art:validate",
    "build": "tsc -p tsconfig.app.json && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run src/lib/domain-runtime.test.ts src/lib/game-runtime.test.ts src/lib/database-runtime.test.ts src/lib/cottage-scene.test.ts src/lib/observatory.test.ts src/lib/angel-ai-runtime.test.ts",
    "test:mail-lifecycle": "node scripts/quality/test-mail-lifecycle.mjs",
    "test:ai-narrative": "node scripts/quality/test-ai-narrative.mjs",
    "test:watch": "vitest",
    "art:validate": "node scripts/quality/validate-art-assets.mjs",
    "art:prepare:cottage": "node scripts/art/prepare-tileset-draft.mjs",
    "art:repair:cottage-floor": "node scripts/art/repair-cottage-floor-draft.mjs",
    "art:test:cottage-seams": "node scripts/art/build-tileset-seam-test.mjs",
    "art:repair:cottage-walls": "node scripts/art/repair-cottage-wall-draft.mjs",
    "art:test:cottage-walls": "node scripts/art/build-cottage-wall-test.mjs",
    "art:prepare:cottage-structure": "node scripts/art/prepare-cottage-structure-drafts.mjs",
    "art:test:cottage-structure": "node scripts/art/build-cottage-structure-test.mjs",
    "art:prepare:player-idle": "node scripts/art/prepare-player-idle-draft.mjs",
    "art:prepare:cloud-rabbit": "node scripts/art/prepare-cloud-rabbit-forms.mjs",
    "art:prepare:ember-drake": "node scripts/art/prepare-ember-drake-forms.mjs",
    "art:build:cottage-backdrop": "node scripts/art/build-cottage-runtime-backdrop.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.personal.hearthcamp",
    "productName": "炉火营地",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/fonts/**/*.woff2",
      "src/data/**/*",
      "assets/branding/app-icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "assets/audio/bgm",
        "to": "audio/bgm",
        "filter": [
          "*.mp3"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/branding/app-icon.png",
      "artifactName": "Hearth-Camp-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "炉火营地",
      "uninstallDisplayName": "炉火营地",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sql.js": "^1.14.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "author": "Personal Learning System"
}
